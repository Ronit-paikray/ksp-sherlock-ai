# Local development
PORT=4000
VITE_API_BASE=

# OpenRouter AI routing
OPENROUTER_API_KEY=
PRIMARY_MODEL=deepseek/deepseek-v4-flash
FALLBACK_MODEL=google/gemini-2.5-flash
DEV_MODEL=qwen/qwen3-coder
AI_TIMEOUT_MS=12000
AI_DEMO_MODE=false
OPENROUTER_SITE_URL=http://localhost:5173

# Catalyst deployment
# Set VITE_API_BASE=/server/sherlock_api before building if API Gateway is not used.

# Never commit real secret values.
ZOHO_CATALYST_PROJECT_ID=
