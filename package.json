{
  "name": "ksp-sherlock-ai",
  "version": "1.0.0",
  "private": true,
  "description": "KSP Sherlock AI - Crime Intelligence Copilot MVP for Datathon 2026",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build && node scripts/prepare-catalyst-client.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.9.3",
    "concurrently": "^10.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^4.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
